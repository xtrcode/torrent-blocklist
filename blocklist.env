# Configuration for the blocklist build (used by docker compose and the GitHub Action).
# Plain KEY=VALUE lines without quotes. Run "docker compose run --rm blocklist help" for all options.

# Base lists: URLs or local paths, separated by commas or newlines.
# Supported: .p2p, .dat, CIDR/IP lists; optionally packed as .zip or .gz.
BLOCKLIST_SOURCES=https://raw.githubusercontent.com/waelisa/Best-blocklist/main/wael.list.p2p.zip

# Block the complete address space of these countries (ISO 3166-1 alpha-2 codes, see https://www.ipdeny.com/ipblocks/).
# Example: BLOCK_COUNTRIES=cn,ru,kp
BLOCK_COUNTRIES=
COUNTRY_IPV4=true
COUNTRY_IPV6=true
COUNTRY_AGGREGATED=true

# Downloaded country zones are reused for this long before ipdeny.com is contacted again.
CACHE_TTL=7d
# Base lists are revalidated on every run (conditional request); cached copies are kept as fallback.
SOURCE_CACHE_TTL=0

# Output
OUTPUT_NAME=blocklist
OUTPUT_FORMATS=p2p,dat,p2b
OUTPUT_GZIP=false
OUTPUT_MANIFEST=true
MERGE_RANGES=true
P2B_VERSION=3

# Behaviour
FAIL_ON_SOURCE_ERROR=true
LOG_LEVEL=info
